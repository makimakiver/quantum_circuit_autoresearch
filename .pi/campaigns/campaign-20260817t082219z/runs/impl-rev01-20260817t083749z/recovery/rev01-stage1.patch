+/// EXP-REV-01 stage-1 attribution knob (TRACE-only). Default off: the helper
+/// below emits nothing, adds no phase transitions, and leaves the artifact
+/// stream byte-identical. When set, each gcd walk body is split into stage
+/// segments so TRACE_TLM_CCX / TRACE_TLM_TOF can attribute the reverse replay
+/// premium to {dialog codec, flag restore, comparator decision/uncompute,
+/// cswap ladder, controlled_add_active, shift tail}.
+fn revtrace_enabled() -> bool {
+    std::env::var("TRACE_TLM_REVERSE_STAGES").is_ok()
+}
+
+#[derive(Clone, Copy)]
+enum RtStage {
+    CmpCompute,
+    Cswap,
+    Add,
+    FlagSwap,
+    CmpUncompute,
+    ShiftTail,
+}
+
+fn rt_phase(circ: &mut B, inverse: bool, reverse: bool, stage: RtStage) {
+    if !revtrace_enabled() {
+        return;
+    }
+    let label = match (inverse, reverse, stage) {
+        (false, false, RtStage::CmpCompute) => "rt_mf_cmp_compute",
+        (false, false, RtStage::Cswap) => "rt_mf_cswap",
+        (false, false, RtStage::Add) => "rt_mf_add",
+        (true, false, RtStage::CmpCompute) => "rt_if_cmp_compute",
+        (true, false, RtStage::Cswap) => "rt_if_cswap",
+        (true, false, RtStage::Add) => "rt_if_add",
+        (false, true, RtStage::FlagSwap) => "rt_mr_flag_swap",
+        (false, true, RtStage::Add) => "rt_mr_add",
+        (false, true, RtStage::Cswap) => "rt_mr_cswap",
+        (false, true, RtStage::CmpUncompute) => "rt_mr_cmp_uncompute",
+        (false, true, RtStage::ShiftTail) => "rt_mr_shift_tail",
+        (true, true, RtStage::FlagSwap) => "rt_ir_flag_swap",
+        (true, true, RtStage::Add) => "rt_ir_add",
+        (true, true, RtStage::Cswap) => "rt_ir_cswap",
+        (true, true, RtStage::CmpUncompute) => "rt_ir_cmp_uncompute",
+        (true, true, RtStage::ShiftTail) => "rt_ir_shift_tail",
+        // Combos that no walk site uses; kept exhaustive rather than panicking.
+        _ => "rt_unused",
+    };
+    circ.set_phase(label);
+}
